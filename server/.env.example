# Server Port
PORT=5000

# Environment mode (development / production / test)
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/nutrilabel
# Production MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nutrilabel?retryWrites=true&w=majority

# Admin Authentication Header (x-admin-password)
ADMIN_PASSWORD=change_this_to_a_secure_password

# Allowed Client Origin(s) for CORS (comma-separated or single domain)
# Local development:
CLIENT_ORIGIN=http://localhost:5173
# Production (Vercel deployment):
# CLIENT_ORIGIN=https://nutrilabel.vercel.app,https://nutrilabel-*.vercel.app
